# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here

# JWT Secret (generar con: python -c "import secrets; print(secrets.token_hex(32))")
# IMPORTANTE: Cambiar esto en producción
SECRET_KEY=your-secret-key-64-characters-minimum-change-this-in-production

# Base de datos (opcional - solo si usas psycopg2 para crear stored procedures)
# DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres
